# Server Configuration
PORT=3000
NODE_ENV=development
APP_BUILD_ID=

# Banco de dados (MySQL via Prisma). Caracteres especiais na senha devem ser URL-encoded (@ = %40)
DATABASE_URL="mysql://USUARIO:SENHA@HOST:3306/BANCO"

# External Image Server (PHP)
IMAGE_SERVER_URL=
IMAGE_SERVER_PASSWORD=

# Google Maps API Key (Server-side proxy routes)
GOOGLE_MAPS_API_KEY=

# Gemini API Key (Server-side)
GEMINI_API_KEY=
